SUBMIT-DESCRIPTION provenance_monitor.sub {
    universe = local
    executable = /home/iaross/single_protein_models_with_ospool/.venv/bin/python3
    arguments = -m mldag.provenance.log_monitor --log-file metl.log --classad-dir output/provenance
    queue
}
SERVICE provenance_monitor provenance_monitor.sub
SUBMIT-DESCRIPTION ospool_pretrain.sub {
	universe = container
	container_image = osdf:///chtc/staging/i/iaross/metl_local.sif

	epoch = $(epoch:1)

	request_disk = 60GB
	request_memory = 20000
	retry_request_memory = 60000
	request_cpus = 4
	request_gpus = 1
	gpus_minimum_memory = 8000

	environment = "WANDB_API_KEY=a1bbea51509891a9a9fb5d9b301a31a5e146bcdf"

	+WantGPULab = true
	+is_resumable = true
	+JobDurationCategory = "Short"
	#+ProjectName = "PATh_MLSupplement"
	want_ospool = true

	executable = /bin/bash
	transfer_executable = false
	arguments = pretrain_local.sh $(epoch) $(run_uuid) $(random_seed) $(protein)
	preserve_relative_paths = true
	transfer_input_files = pretrain_local.sh, osdf:///chtc/staging/i/iaross/metl_rosetta_datasets/processed-$(protein).tar.gz?pack=auto
	if defined continue_from_checkpoint
	    transfer_input_files = $(transfer_input_files), output/training_logs/$(run_uuid)
	endif
	transfer_output_files = output
	should_transfer_files = YES
	when_to_transfer_output = ON_EXIT_OR_EVICT

	output = $(run_uuid)/$(epoch)_$(CLUSTERID).out
	error = $(run_uuid)/$(epoch)_$(CLUSTERID).err
	stream_output = True
	stream_error = True
	log = metl.log
	priority = $(epoch)

	TARGET.GLIDEIN_ResourceName == "$(ResourceName)"
	environment = "PROVENANCE_RUN_ID=$(run_uuid) MLDAG_VERSION=0.1.0rc11 WANDB_API_KEY=123"
	job_ad_file = output/provenance/$(ClusterId).ad
	queue
}
JOB run0-train_epoch0 ospool_pretrain.sub
